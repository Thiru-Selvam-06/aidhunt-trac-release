rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    // Firebase Auth signs this claim; a form's phone number is not OTP evidence.
    function verifiedPhone() {
      return signed() && request.auth.token.get('phone_number', '') is string &&
        request.auth.token.get('phone_number', '') != '';
    }
    function memberPath(ws, uid) { return /databases/$(database)/documents/workspaces/$(ws)/members/$(uid); }
    function active(ws, uid) {
      return uid is string && uid != '' && exists(memberPath(ws, uid)) &&
        get(memberPath(ws, uid)).data.status in ['ACTIVE', 'active'];
    }
    function member(ws) { return signed() && active(ws, request.auth.uid) && (owner(ws) || partner(ws) || operator(ws)); }
    function role(ws, roles) {
      return signed() && get(memberPath(ws, request.auth.uid)).data.status in ['ACTIVE', 'active'] &&
        get(memberPath(ws, request.auth.uid)).data.role in roles;
    }
    function owner(ws) {
      return role(ws, ['OWNER', 'Owner', 'owner']) &&
        get(/databases/$(database)/documents/workspaces/$(ws)).data.ownerUid == request.auth.uid;
    }
    function partner(ws) { return role(ws, ['PARTNER', 'Partner', 'partner']); }
    function operator(ws) { return role(ws, ['OPERATOR', 'Operator', 'operator']); }
    function finance(ws) { return owner(ws) || partner(ws); }
    // Partner companion expenses follow the selected beneficiary of their own job.
    function linkedExpenseTarget(ws, data) {
      let job = getAfter(/databases/$(database)/documents/workspaces/$(ws)/entries/$(string(data.get('relatedJobId', 0))));
      return partner(ws) && data.get('relatedJobId', 0) is int && data.relatedJobId > 0 &&
        job.data.workspaceId == ws && job.data.createdByUid == request.auth.uid &&
        job.data.entryForUid == data.expenseForUid && job.data.isHistorical == false &&
        job.data.get('isDeleted', false) == false;
    }
    function financialStatePath(ws) { return /databases/$(database)/documents/workspaces/$(ws)/financialState/current; }
    function cashOpPath(ws, opId) { return /databases/$(database)/documents/workspaces/$(ws)/cashOperations/$(opId); }
    function cashDeleteProofPath(ws, kind, id) { return /databases/$(database)/documents/workspaces/$(ws)/cashDeleteProofs/$(kind + '_' + id); }
    function atomicCashEnabled(ws) {
      return syncCapability(ws, 'atomicCashControlV1') || exists(financialStatePath(ws));
    }
    function canonicalPaymentMethod(method) {
      return method in ['Cash', 'UPI / GPay', 'Bank Transfer', 'UPI', 'Bank', 'Cheque'];
    }
    function canonicalExpensePaidBy(paidBy) {
      return paidBy in ['Business Paid', 'I Paid', 'Loan Funded'];
    }
    function expenseCashOutflow(data) {
      return data.get('paidBy', '') == 'Business Paid' ? data.amount : 0;
    }
    function matchesCashOpData(op, ws, opId, entityType, entityId, mutationType, expectedDelta) {
      return op.workspaceId == ws && op.operationId == opId &&
        op.entityType == entityType && op.entityId == entityId &&
        op.mutationType == mutationType && op.actorUid == request.auth.uid &&
        sameMoney(op.cashDelta, expectedDelta);
    }
    function matchesCashOp(ws, opId, entityType, entityId, mutationType, expectedDelta) {
      let path = cashOpPath(ws, opId);
      return opId is string && opId.matches('^[A-Za-z0-9:_-]{1,160}$') &&
        !exists(path) && existsAfter(path) &&
        matchesCashOpData(getAfter(path).data, ws, opId, entityType, entityId, mutationType, expectedDelta);
    }
    function activeCashDeleteProof(ws, kind, id) {
      let p = cashDeleteProofPath(ws, kind, id);
      return !exists(p) && existsAfter(p) &&
        getAfter(p).data.workspaceId == ws &&
        getAfter(p).data.kind == kind &&
        getAfter(p).data.recordId == id &&
        getAfter(p).data.actorUid == request.auth.uid;
    }
    function cashDeleteProofActionTime(ws, kind, id) {
      return getAfter(cashDeleteProofPath(ws, kind, id)).data.actionTime;
    }
    function jobVerifiedExpenseSum(ws, jobId, ids, index) {
      return ids.size() <= index ? 0 : jobSingleVerifiedExpense(ws, jobId, ids[index]);
    }
    function jobSingleVerifiedExpenseAmount(e, ws, jobId) {
      return e.workspaceId == ws && string(e.get('relatedJobId', 0)) == jobId
        ? (e.get('paidBy', '') == 'Business Paid' ? e.amount : 0)
        : -1;
    }
    function jobSingleVerifiedExpense(ws, jobId, eid) {
      let ePath = /databases/$(database)/documents/workspaces/$(ws)/expenses/$(eid);
      return eid is string && eid != '' && exists(ePath) && !existsAfter(ePath)
        ? jobSingleVerifiedExpenseAmount(get(ePath).data, ws, jobId)
        : -1;
    }
    function validJobCashReceiptWithProof(ws, op, proof) {
      let ids = op.get('verifiedExpenseIds', []);
      let e0 = jobVerifiedExpenseSum(ws, op.entityId, ids, 0);
      let e1 = jobVerifiedExpenseSum(ws, op.entityId, ids, 1);
      let e2 = jobVerifiedExpenseSum(ws, op.entityId, ids, 2);
      return proof.operationId == op.operationId && proof.actorUid == request.auth.uid &&
        op.cashDelta >= -proof.amountReceived - 0.000001 &&
        (proof.get('deletedExpenseAuditJson', '[]') == '[]'
          ? op.cashDelta <= 0.000001
          : (owner(ws) || (ids is list && ids.size() <= 3 && ids.toSet().size() == ids.size() &&
              e0 >= 0 && e1 >= 0 && e2 >= 0 && op.cashDelta <= e0 + e1 + e2 + 0.000001)));
    }
    function validJobCashReceipt(ws, op) {
      let pPath = entryProofPath(ws, op.entityId);
      return op.mutationType == 'DELETE' && !exists(pPath) && existsAfter(pPath) &&
        validJobCashReceiptWithProof(ws, op, getAfter(pPath).data);
    }
    function validExpenseUpsertData(ws, op, prevOut, eAfter) {
      let nextOut = expenseCashOutflow(eAfter);
      return eAfter.operationId == op.operationId &&
        eAfter.actorUid == request.auth.uid &&
        !sameMoney(prevOut, nextOut) &&
        sameMoney(op.cashDelta, prevOut - nextOut);
    }
    function validExpenseUpsertReceipt(ws, op) {
      let ePath = /databases/$(database)/documents/workspaces/$(ws)/expenses/$(op.entityId);
      let prevOut = exists(ePath) ? expenseCashOutflow(get(ePath).data) : 0;
      return op.mutationType == 'UPSERT' && existsAfter(ePath) &&
        validExpenseUpsertData(ws, op, prevOut, getAfter(ePath).data);
    }
    function validExpenseDeleteReceipt(ws, op) {
      let ePath = /databases/$(database)/documents/workspaces/$(ws)/expenses/$(op.entityId);
      let dpPath = cashDeleteProofPath(ws, 'EXPENSE', op.entityId);
      return op.mutationType == 'DELETE' && exists(ePath) && !existsAfter(ePath) &&
        !exists(dpPath) && existsAfter(dpPath) &&
        getAfter(dpPath).data.operationId == op.operationId &&
        get(ePath).data.get('paidBy', '') == 'Business Paid' &&
        sameMoney(op.cashDelta, get(ePath).data.amount);
    }
    function validWithdrawalUpsertData(ws, op, wAfter, fsAfter) {
      return wAfter.operationId == op.operationId && wAfter.actorUid == request.auth.uid &&
        sameMoney(op.cashDelta, -wAfter.amount) &&
        fsAfter.confirmedCash - fsAfter.get('reservedCash', 0) >= -0.000001;
    }
    function validWithdrawalReceipt(ws, op, fsAfter) {
      let wPath = /databases/$(database)/documents/workspaces/$(ws)/withdrawals/$(op.entityId);
      let dpPath = cashDeleteProofPath(ws, 'WITHDRAWAL', op.entityId);
      return (op.mutationType == 'UPSERT' && !exists(wPath) && existsAfter(wPath) &&
          validWithdrawalUpsertData(ws, op, getAfter(wPath).data, fsAfter)) ||
        (op.mutationType == 'DELETE' && exists(wPath) && !existsAfter(wPath) &&
          !exists(dpPath) && existsAfter(dpPath) && getAfter(dpPath).data.operationId == op.operationId &&
          sameMoney(op.cashDelta, get(wPath).data.amount));
    }
    function validPaymentUpsertData(op, cAfter) {
      return cAfter.operationId == op.operationId && cAfter.actorUid == request.auth.uid &&
        cAfter.status == 'ACTIVE' && cAfter.paymentMethod == 'Cash' &&
        sameMoney(op.cashDelta, cAfter.amount);
    }
    function validPaymentReverseData(op, cBefore, cAfter) {
      return cBefore.status == 'ACTIVE' && cAfter.status == 'REVERSED' &&
        cBefore.paymentMethod == 'Cash' && cAfter.paymentMethod == 'Cash' &&
        cAfter.operationId == op.operationId && cAfter.actorUid == request.auth.uid &&
        sameMoney(op.cashDelta, -cBefore.amount);
    }
    function validPaymentReceipt(ws, op) {
      let cPath = /databases/$(database)/documents/workspaces/$(ws)/collections/$(op.entityId);
      return (op.mutationType == 'UPSERT' && !exists(cPath) && existsAfter(cPath) &&
          validPaymentUpsertData(op, getAfter(cPath).data)) ||
        (op.mutationType == 'REVERSE' && exists(cPath) && existsAfter(cPath) &&
          validPaymentReverseData(op, get(cPath).data, getAfter(cPath).data));
    }
    function validExternalLoanReceipt(ws, op, fsAfter) {
      let lPath = /databases/$(database)/documents/workspaces/$(ws)/externalLoans/$(op.entityId);
      let lAfter = getAfter(lPath).data;
      return op.mutationType == 'UPSERT' && !exists(lPath) && existsAfter(lPath) &&
        lAfter.operationId == op.operationId && lAfter.actorUid == request.auth.uid &&
        ((lAfter.destination == 'BUSINESS_CASH' && sameMoney(op.cashDelta, lAfter.principalAmount) && sameMoney(op.get('bankDelta', 0), 0)) ||
         (lAfter.destination == 'BUSINESS_BANK' && sameMoney(op.cashDelta, 0) && sameMoney(op.get('bankDelta', 0), lAfter.principalAmount)));
    }
    function validExternalLoanRepaymentReceipt(ws, op, fsAfter) {
      let rPath = /databases/$(database)/documents/workspaces/$(ws)/externalLoanRepayments/$(op.entityId);
      let rAfter = getAfter(rPath).data;
      let total = rAfter.principalPaid + rAfter.interestPaid;
      return op.mutationType == 'UPSERT' && !exists(rPath) && existsAfter(rPath) &&
        rAfter.operationId == op.operationId && rAfter.actorUid == request.auth.uid &&
        total > 0 &&
        ((rAfter.source == 'BUSINESS_CASH' && sameMoney(op.cashDelta, -total) && sameMoney(op.get('bankDelta', 0), 0) &&
          fsAfter.confirmedCash - fsAfter.get('reservedCash', 0) >= -0.000001) ||
         (rAfter.source == 'BUSINESS_BANK' && sameMoney(op.cashDelta, 0) && sameMoney(op.get('bankDelta', 0), -total) &&
          fsAfter.get('confirmedBank', 0) >= -0.000001));
    }
    function validBorrowingRequestReceipt(ws, op, fsAfter) {
      let bPath = /databases/$(database)/documents/workspaces/$(ws)/borrowingRequests/$(op.entityId);
      let bAfter = getAfter(bPath).data;
      return existsAfter(bPath) && bAfter.operationId == op.operationId && bAfter.actorUid == request.auth.uid &&
        sameMoney(op.get('bankDelta', 0), 0) &&
        ((op.mutationType == 'UPSERT' && !exists(bPath) && bAfter.sourceType == 'BUSINESS_ONLY' &&
          bAfter.status == 'EXECUTED' && sameMoney(op.cashDelta, -bAfter.amount) && sameMoney(op.reservedDelta, 0) &&
          fsAfter.confirmedCash - fsAfter.get('reservedCash', 0) >= -0.000001) ||
         (op.mutationType == 'APPROVE_RESERVE' && exists(bPath) &&
          bAfter.status == 'APPROVED_RESERVED' && sameMoney(op.cashDelta, 0) && sameMoney(op.reservedDelta, bAfter.amount) &&
          fsAfter.confirmedCash - fsAfter.get('reservedCash', 0) >= -0.000001) ||
         (op.mutationType == 'EXECUTE' && exists(bPath) &&
          bAfter.status == 'EXECUTED' && sameMoney(op.cashDelta, -bAfter.amount) &&
          sameMoney(op.reservedDelta, -get(bPath).data.reservedAmount) &&
          fsAfter.confirmedCash - fsAfter.get('reservedCash', 0) >= -0.000001) ||
         (op.mutationType in ['CANCEL', 'REJECT'] && exists(bPath) &&
          bAfter.status in ['CANCELLED', 'REJECTED'] && sameMoney(op.cashDelta, 0) &&
          sameMoney(op.reservedDelta, -get(bPath).data.reservedAmount)));
    }
    function validSettlementRepaymentReceipt(ws, op) {
      let sPath = /databases/$(database)/documents/workspaces/$(ws)/settlementRepayments/$(op.entityId);
      let sAfter = getAfter(sPath).data;
      return op.mutationType == 'CONFIRM' && exists(sPath) && existsAfter(sPath) &&
        sAfter.operationId == op.operationId && sAfter.actorUid == request.auth.uid &&
        sAfter.status == 'CONFIRMED' && sAfter.mode in ['INTO_BUSINESS', 'INTO_BUSINESS_FOR_PARTNER'] &&
        sameMoney(op.cashDelta, sAfter.amount) && sameMoney(op.reservedDelta, 0) && sameMoney(op.get('bankDelta', 0), 0);
    }
    function validCashReceiptStates(ws, opId, op, fsBefore, fsAfter) {
      return fsBefore.workspaceId == ws && fsBefore.version == op.expectedVersion &&
        fsAfter.workspaceId == ws && fsAfter.version == op.newVersion &&
        fsAfter.lastOperationId == opId &&
        sameMoney(fsAfter.confirmedCash, fsBefore.confirmedCash + op.cashDelta) &&
        sameMoney(op.confirmedCashAfter, fsAfter.confirmedCash) &&
        sameMoney(fsAfter.get('reservedCash', 0), fsBefore.get('reservedCash', 0) + op.reservedDelta) &&
        sameMoney(fsAfter.get('confirmedBank', 0), fsBefore.get('confirmedBank', 0) + op.get('bankDelta', 0)) &&
        (!op.keys().hasAny(['reservedCashAfter']) || sameMoney(op.reservedCashAfter, fsAfter.get('reservedCash', 0))) &&
        (!op.keys().hasAny(['confirmedBankAfter']) || sameMoney(op.confirmedBankAfter, fsAfter.get('confirmedBank', 0))) &&
        (op.entityType == 'WITHDRAWAL' ? validWithdrawalReceipt(ws, op, fsAfter)
         : op.entityType == 'PAYMENT' ? validPaymentReceipt(ws, op)
         : op.entityType == 'EXPENSE' ? (op.mutationType == 'DELETE' ? validExpenseDeleteReceipt(ws, op) : validExpenseUpsertReceipt(ws, op))
         : op.entityType == 'JOB' ? validJobCashReceipt(ws, op)
         : op.entityType == 'EXTERNAL_LOAN' ? validExternalLoanReceipt(ws, op, fsAfter)
         : op.entityType == 'EXTERNAL_LOAN_REPAYMENT' ? validExternalLoanRepaymentReceipt(ws, op, fsAfter)
         : op.entityType == 'BORROWING_REQUEST' ? validBorrowingRequestReceipt(ws, op, fsAfter)
         : op.entityType == 'SETTLEMENT_REPAYMENT' ? validSettlementRepaymentReceipt(ws, op)
         : (op.entityType == 'PURGE' && op.mutationType == 'PURGE' && purge(ws, op.entityId)));
    }
    function validFinancialStateCashOp(ws, opId, op) {
      return op.operationId == opId &&
        op.expectedVersion == resource.data.version &&
        op.newVersion == request.resource.data.version &&
        sameMoney(op.confirmedCashAfter, request.resource.data.confirmedCash) &&
        sameMoney(request.resource.data.confirmedCash, resource.data.confirmedCash + op.cashDelta) &&
        sameMoney(request.resource.data.reservedCash, resource.data.get('reservedCash', 0) + op.reservedDelta) &&
        sameMoney(request.resource.data.get('confirmedBank', 0), resource.data.get('confirmedBank', 0) + op.get('bankDelta', 0)) &&
        request.resource.data.get('confirmedBank', 0) >= -0.000001 &&
        op.entityType == request.resource.data.lastEntityType &&
        op.entityId == request.resource.data.lastEntityId &&
        op.actorUid == request.auth.uid &&
        op.actionTime == request.resource.data.actionTime;
    }
    function validWithdrawalCashDelete(ws, id, dp) {
      return activeRecord(ws, 'targetPartnerUid') &&
        (owner(ws) || (partner(ws) && resource.data.targetPartnerUid == request.auth.uid && reviewedTime() &&
          resource.data.createdByUid == request.auth.uid &&
          resource.data.get('createdAt', 0) is int && resource.data.createdAt > 0 &&
          dp.actionTime >= resource.data.createdAt && dp.actionTime - resource.data.createdAt < 86400000)) &&
        matchesCashOp(ws, dp.operationId, 'WITHDRAWAL', id, 'DELETE', resource.data.amount);
    }
    function validExpenseCashDelete(ws, id, dp) {
      return unlockedExpenseDelete(ws, resource.data) && activeRecord(ws, 'expenseForUid') &&
        (owner(ws) || (partner(ws) && reviewedTime() && resource.data.createdByUid == request.auth.uid &&
          resource.data.get('createdAt', 0) is int && resource.data.createdAt > 0 &&
          dp.actionTime >= resource.data.createdAt && dp.actionTime - resource.data.createdAt < 86400000)) &&
        (resource.data.get('paidBy', '') != 'Business Paid' ||
          matchesCashOp(ws, dp.operationId, 'EXPENSE', id, 'DELETE', resource.data.amount));
    }
    function validCashReceipt(ws, opId) {
      let op = request.resource.data;
      return !exists(cashOpPath(ws, opId)) &&
        op.keys().hasOnly([
          'workspaceId', 'operationId', 'entityType', 'entityId', 'mutationType',
          'actorUid', 'actionTime', 'cashDelta', 'reservedDelta', 'reservedCashAfter',
          'bankDelta', 'confirmedBankAfter', 'expectedVersion',
          'newVersion', 'confirmedCashAfter', 'createdAt', 'verifiedExpenseIds'
        ]) &&
        op.workspaceId == ws &&
        op.operationId == opId && op.operationId is string && op.operationId.matches('^[A-Za-z0-9:_-]{1,160}$') &&
        op.actorUid == request.auth.uid &&
        op.actionTime is int && op.actionTime > 0 && op.actionTime <= request.time.toMillis() &&
        op.createdAt == request.time &&
        op.entityType in ['WITHDRAWAL', 'PAYMENT', 'EXPENSE', 'JOB', 'PURGE',
          'EXTERNAL_LOAN', 'EXTERNAL_LOAN_REPAYMENT', 'BORROWING_REQUEST', 'SETTLEMENT_REPAYMENT'] &&
        op.entityId is string && op.entityId != '' &&
        op.mutationType in ['UPSERT', 'DELETE', 'REVERSE', 'PURGE', 'APPROVE_RESERVE', 'EXECUTE', 'CANCEL', 'REJECT', 'CONFIRM'] &&
        (!op.keys().hasAny(['verifiedExpenseIds']) || op.entityType == 'JOB') &&
        op.cashDelta is number && op.reservedDelta is number &&
        (op.entityType == 'BORROWING_REQUEST' || sameMoney(op.reservedDelta, 0)) &&
        (!op.keys().hasAny(['bankDelta']) || (op.entityType in ['EXTERNAL_LOAN', 'EXTERNAL_LOAN_REPAYMENT'] && op.bankDelta is number)) &&
        op.expectedVersion is int && op.expectedVersion >= 1 &&
        op.newVersion is int && op.newVersion == op.expectedVersion + 1 &&
        op.confirmedCashAfter is number &&
        exists(financialStatePath(ws)) && existsAfter(financialStatePath(ws)) &&
        validCashReceiptStates(ws, opId, op, get(financialStatePath(ws)).data, getAfter(financialStatePath(ws)).data);
    }
    function envelope(ws) {
      return request.resource.data.protocolVersion == 2 && request.resource.data.operationType in ['UPSERT', 'DELETE'] && request.resource.data.dependencies is list && request.resource.data.dependencies.size() <= 100 &&
        request.resource.data.workspaceId == ws && request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.operationId is string && request.resource.data.operationId != '' &&
        request.resource.data.actionTime is int && request.resource.data.actionTime > 0 &&
        request.resource.data.actionTime <= request.time.toMillis() && request.resource.data.isDeleted is bool &&
        (request.resource.data.isDeleted
          ? request.resource.data.get('authorizationDeletedAt', null) == request.time
          : request.resource.data.get('authorizationDeletedAt', null) == null);
    }
    // Approved offline policy: client action time is not tamper-proof. createdAt is immutable.
    function timely(createdAt) {
      return createdAt is int && createdAt > 0 && request.resource.data.actionTime >= createdAt &&
        request.resource.data.actionTime - createdAt < 86400000;
    }
    function same(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function original() { return same(['workspaceId', 'createdByUid', 'createdByRole', 'createdAt', 'authorizationCreatedAt', 'serverReceivedAt', 'authorizationTimeStatus']); }
    function reviewedTime() { return resource.data.get('authorizationTimeStatus', '') in ['CLIENT_ORIGINAL_V2', 'VERIFIED']; }
    function ownTimely() { return reviewedTime() && resource.data.createdByUid == request.auth.uid && reviewedTime() && timely(resource.data.get('createdAt', 0)); }
    // The queued command remains durable until this physical delete is acknowledged.
    function deleteEnvelope() {
      return resource.data.get('protocolVersion', 0) == 2 && resource.data.get('operationType', '') in ['UPSERT', 'DELETE'] && resource.data.get('dependencies', null) is list && resource.data.get('isDeleted', false) == true && resource.data.actorUid == request.auth.uid &&
        resource.data.operationId is string && resource.data.operationId != '' && resource.data.actionTime is int &&
        resource.data.actionTime > 0 && resource.data.actionTime <= request.time.toMillis();
    }
    function deleteTimely() {
      let created = resource.data.get('createdAt', 0);
      let action = resource.data.actionTime;
      return reviewedTime() && resource.data.createdByUid == request.auth.uid && created is int && created > 0 &&
        action >= created && action - created < 86400000;
    }
    function notDeleted() { return resource.data.get('isDeleted', false) == false; }
    function activeRecord(ws, targetField) {
      return active(ws, resource.data.createdByUid) && active(ws, resource.data[targetField]);
    }
    function purge(ws, uid) {
      return uid is string && uid != '' && owner(ws) &&
        exists(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)) &&
        get(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)).data.purgeState == 'PURGE_PENDING' &&
        get(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)).data.get('backupReady', false) == true;
    }
    function memberPurging(ws, uid) {
      return uid is string && uid != '' && exists(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)) &&
        get(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)).data.purgeState in ['PURGE_PENDING', 'PURGED'];
    }
    function jobEditValues(data) {
      return {'customerId': data.get('customerId', null),
        'customerName': data.get('customerName', null),
        'customerPhone': data.get('customerPhone', null),
        'customerLocation': data.get('customerLocation', null),
        'operatorName': data.get('operatorName', null),
        'tractorId': data.get('tractorId', null),
        'tractorLabel': data.get('tractorLabel', null),
        'workType': data.get('workType', null),
        'startTimeMillis': data.get('startTimeMillis', null),
        'endTimeMillis': data.get('endTimeMillis', null),
        'durationMinutes': data.get('durationMinutes', null),
        'hourlyRate': data.get('hourlyRate', null),
        'totalAmount': data.get('totalAmount', null),
        'notes': data.get('notes', null)};
    }
    function validJobEditAudit(before, after) {
      let previous = before.get('jobEditHistory', []);
      let next = after.get('jobEditHistory', []);
      return previous is list && next is list &&
        ((!('jobEditHistory' in before) && !('jobEditHistory' in after)) ||
         (next == previous && same(['customerId','customerName','customerPhone','customerLocation','operatorName','tractorId','tractorLabel','workType','startTimeMillis','endTimeMillis','durationMinutes','hourlyRate','totalAmount','notes','editedByUid','editedByName','editedByRole','updatedAt'])) ||
         (previous.size() < 100 && after.editedByUid == request.auth.uid && after.updatedAt == after.actionTime && next == previous.concat([{
           'actorUid': request.auth.uid, 'operationId': after.operationId, 'actionTime': after.actionTime,
           'before': jobEditValues(before), 'after': jobEditValues(after)
         }])));
    }
    // Keep exact historical equality; permit only binary noise around the same paisa.
    // A mismatched paisa or a newly fabricated sub-paisa delta never satisfies this.
    function sameMoney(actual, expected) {
      return actual == expected || (math.abs(actual - expected) < 0.000000001 &&
        math.abs(actual * 100 - math.round(actual * 100)) < 0.000001 &&
        math.abs(expected * 100 - math.round(expected * 100)) < 0.000001);
    }
    function validEntryAmounts(data) {
      return data.totalAmount is number && data.totalAmount >= 0 && data.amountReceived is number &&
        data.amountReceived >= 0 && data.pendingAmount is number && data.pendingAmount >= 0 &&
        sameMoney(data.totalAmount, data.amountReceived + data.pendingAmount);
    }
    // Append-only evidence for future customer moves; pre-existing entries need no migration.
    function validCustomerReassignment(before, after) {
      let previous = before == null ? [] : before.get('customerReassignmentHistory', []);
      let next = after.get('customerReassignmentHistory', []);
      return previous is list && next is list &&
        (before == null ? next.size() == 0 :
          ((!('customerReassignmentHistory' in before) && !('customerReassignmentHistory' in after)) ||
          (before.customerId == after.customerId ? next == previous :
            (previous.size() < 1000 && next == previous.concat([{
              'fromCustomerId': before.customerId, 'toCustomerId': after.customerId,
