        allow read: if finance(ws);
        allow create: if envelope(ws) && finance(ws) && request.resource.data.isDeleted == false &&
          request.resource.data.id is int && request.resource.data.id > 0 && string(request.resource.data.id) == id &&
          request.resource.data.amount is number && request.resource.data.amount > 0 &&
          active(ws, request.resource.data.borrowerUid) &&
          (request.resource.data.borrowerUid == request.auth.uid || owner(ws)) &&
          ((request.resource.data.sourceType == 'BUSINESS_ONLY' &&
            request.resource.data.status == 'EXECUTED' &&
            sameMoney(request.resource.data.get('reservedAmount', 0), 0) &&
            request.resource.data.withdrawalId is int && request.resource.data.withdrawalId > 0 &&
            request.resource.data.obligationId is int && request.resource.data.obligationId > 0 &&
            existsAfter(/databases/$(database)/documents/workspaces/$(ws)/withdrawals/$(string(request.resource.data.withdrawalId))) &&
            existsAfter(/databases/$(database)/documents/workspaces/$(ws)/settlementObligations/$(string(request.resource.data.obligationId))) &&
            (!atomicCashEnabled(ws) || matchesCashOp(ws, request.resource.data.operationId, 'BORROWING_REQUEST', id, 'UPSERT', -request.resource.data.amount))) ||
           (request.resource.data.sourceType == 'NAMED_PARTNER' &&
            request.resource.data.status == 'PENDING_APPROVAL' &&
            sameMoney(request.resource.data.get('reservedAmount', 0), 0) &&
            request.resource.data.lendingPartnerUid is string &&
            request.resource.data.lendingPartnerUid != request.resource.data.borrowerUid &&
            active(ws, request.resource.data.lendingPartnerUid)));
        allow update: if envelope(ws) && finance(ws) && request.resource.data.isDeleted == false &&
          same(['id', 'workspaceId', 'borrowerUid', 'lendingPartnerUid', 'sourceType', 'amount', 'createdAt', 'requestedByUid', 'requestedByRole']) &&
          ((resource.data.status == 'PENDING_APPROVAL' && request.resource.data.status == 'APPROVED_RESERVED' &&
            request.auth.uid == resource.data.lendingPartnerUid &&
            sameMoney(request.resource.data.reservedAmount, resource.data.amount) &&
            (!atomicCashEnabled(ws) || matchesCashOp(ws, request.resource.data.operationId, 'BORROWING_REQUEST', id, 'APPROVE_RESERVE', 0))) ||
           (resource.data.status == 'PENDING_APPROVAL' && request.resource.data.status == 'REJECTED' &&
            request.auth.uid == resource.data.lendingPartnerUid &&
            sameMoney(request.resource.data.reservedAmount, 0)) ||
           (resource.data.status == 'PENDING_APPROVAL' && request.resource.data.status == 'CANCELLED' &&
            (request.auth.uid == resource.data.borrowerUid || request.auth.uid == resource.data.requestedByUid || owner(ws)) &&
            sameMoney(request.resource.data.reservedAmount, 0)) ||
           (resource.data.status == 'APPROVED_RESERVED' && request.resource.data.status in ['CANCELLED', 'REJECTED'] &&
            sameMoney(request.resource.data.reservedAmount, 0) &&
            ((request.resource.data.status == 'REJECTED' && request.auth.uid == resource.data.lendingPartnerUid) ||
             (request.resource.data.status == 'CANCELLED' && (request.auth.uid == resource.data.borrowerUid || request.auth.uid == resource.data.requestedByUid || owner(ws)))) &&
            (!atomicCashEnabled(ws) || resource.data.reservedAmount <= 0 ||
              matchesCashOp(ws, request.resource.data.operationId, 'BORROWING_REQUEST', id,
                request.resource.data.status == 'CANCELLED' ? 'CANCEL' : 'REJECT', 0))) ||
           (resource.data.status == 'APPROVED_RESERVED' && request.resource.data.status == 'EXECUTED' &&
            (request.auth.uid == resource.data.borrowerUid || owner(ws)) &&
            sameMoney(request.resource.data.reservedAmount, 0) &&
            request.resource.data.withdrawalId is int && request.resource.data.withdrawalId > 0 &&
            request.resource.data.obligationId is int && request.resource.data.obligationId > 0 &&
            existsAfter(/databases/$(database)/documents/workspaces/$(ws)/withdrawals/$(string(request.resource.data.withdrawalId))) &&
            existsAfter(/databases/$(database)/documents/workspaces/$(ws)/settlementObligations/$(string(request.resource.data.obligationId))) &&
            (!atomicCashEnabled(ws) || matchesCashOp(ws, request.resource.data.operationId, 'BORROWING_REQUEST', id, 'EXECUTE', -resource.data.amount))));
        allow delete: if false;
      }
      match /settlementObligations/{id} {
        allow read: if finance(ws);
        allow create: if envelope(ws) && finance(ws) && request.resource.data.isDeleted == false &&
          request.resource.data.id is int && request.resource.data.id > 0 && string(request.resource.data.id) == id &&
          request.resource.data.principalAmount is number && request.resource.data.principalAmount > 0 &&
          sameMoney(request.resource.data.get('repaidAmount', 0), 0) &&
          sameMoney(request.resource.data.get('directSettledAmount', 0), 0) &&
          request.resource.data.status == 'OPEN' &&
          request.resource.data.creditorType in ['BUSINESS', 'PARTNER'] &&
          request.resource.data.sourceRequestId is int && request.resource.data.sourceRequestId > 0 &&
          existsAfter(/databases/$(database)/documents/workspaces/$(ws)/borrowingRequests/$(string(request.resource.data.sourceRequestId))) &&
          getAfter(/databases/$(database)/documents/workspaces/$(ws)/borrowingRequests/$(string(request.resource.data.sourceRequestId))).data.obligationId == int(id) &&
          getAfter(/databases/$(database)/documents/workspaces/$(ws)/borrowingRequests/$(string(request.resource.data.sourceRequestId))).data.operationId == request.resource.data.operationId;
        allow update: if envelope(ws) && finance(ws) && request.resource.data.isDeleted == false &&
          same(['id', 'workspaceId', 'borrowerUid', 'creditorType', 'creditorUid', 'sourceRequestId', 'principalAmount', 'createdAt', 'createdByUid']) &&
          request.resource.data.repaidAmount is number &&
          request.resource.data.repaidAmount > resource.data.repaidAmount &&
          request.resource.data.repaidAmount <= resource.data.principalAmount + 0.000001 &&
          request.resource.data.directSettledAmount >= resource.data.get('directSettledAmount', 0) &&
          request.resource.data.status in ['OPEN', 'SETTLED'];
        allow delete: if false;
      }
      match /settlementRepayments/{id} {
        allow read: if finance(ws);
        allow create: if envelope(ws) && finance(ws) && request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.isDeleted == false &&
          request.resource.data.id is int && request.resource.data.id > 0 && string(request.resource.data.id) == id &&
          request.resource.data.obligationId is int && request.resource.data.obligationId > 0 &&
          request.resource.data.amount is number && request.resource.data.amount > 0 &&
          request.resource.data.status == 'PENDING_CONFIRMATION' &&
          request.resource.data.mode in ['INTO_BUSINESS', 'INTO_BUSINESS_FOR_PARTNER', 'DIRECT_TO_PARTNER'] &&
          exists(/databases/$(database)/documents/workspaces/$(ws)/settlementObligations/$(string(request.resource.data.obligationId)));
        allow update: if envelope(ws) && finance(ws) && request.resource.data.isDeleted == false &&
          resource.data.status == 'PENDING_CONFIRMATION' &&
          same(['id', 'workspaceId', 'obligationId', 'payerUid', 'creditorType', 'creditorUid', 'amount', 'mode', 'paidAt', 'createdAt', 'createdByUid']) &&
          ((request.resource.data.status == 'REJECTED' &&
            (resource.data.mode != 'DIRECT_TO_PARTNER' || request.auth.uid == resource.data.creditorUid)) ||
           (request.resource.data.status == 'CONFIRMED' &&
            request.resource.data.confirmedByUid == request.auth.uid &&
            (resource.data.mode != 'DIRECT_TO_PARTNER' || request.auth.uid == resource.data.creditorUid) &&
            existsAfter(/databases/$(database)/documents/workspaces/$(ws)/settlementObligations/$(string(resource.data.obligationId))) &&
            getAfter(/databases/$(database)/documents/workspaces/$(ws)/settlementObligations/$(string(resource.data.obligationId))).data.operationId == request.resource.data.operationId &&
            (resource.data.mode == 'DIRECT_TO_PARTNER' || !atomicCashEnabled(ws) ||
              matchesCashOp(ws, request.resource.data.operationId, 'SETTLEMENT_REPAYMENT', id, 'CONFIRM', resource.data.amount))));
        allow delete: if false;
      }
      match /notifications/{notifId} {
        allow read: if owner(ws) || (partner(ws) && resource.data.recipientUid == request.auth.uid);
        allow create: if finance(ws) &&
          request.resource.data.keys().hasOnly([
            'id', 'workspaceId', 'operationId', 'recipientUid', 'targetAudience',
            'actorUid', 'actorName', 'eventType', 'entityType', 'entityId',
            'amount', 'counterpartyName', 'metadataJson', 'createdAt', 'isRead', 'readAt'
          ]) &&
          request.resource.data.workspaceId == ws &&
          request.resource.data.id == notifId &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.recipientUid is string &&
          request.resource.data.recipientUid != '' &&
          request.resource.data.recipientUid != request.auth.uid &&
          request.resource.data.operationId is string && request.resource.data.operationId != '' &&
          request.resource.data.targetAudience in ['OWNER_ONLY', 'PARTNER_TARGETED'] &&
          request.resource.data.eventType is string && request.resource.data.eventType != '' &&
          request.resource.data.entityType is string &&
          request.resource.data.entityId is int &&
          request.resource.data.amount is number &&
          request.resource.data.createdAt is int && request.resource.data.createdAt > 0 &&
          request.resource.data.createdAt <= request.time.toMillis() &&
          request.resource.data.isRead == false &&
          request.resource.data.readAt == 0;
        allow update: if (owner(ws) || (partner(ws) && resource.data.recipientUid == request.auth.uid)) &&
          resource.data.actorUid != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']) &&
          request.resource.data.isRead == true &&
          request.resource.data.readAt is int && request.resource.data.readAt > 0;
        allow delete: if false;
      }
      match /auditEvents/{eventId} {
        allow read: if owner(ws);
        allow create: if member(ws) &&
          request.resource.data.workspaceId == ws &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.eventId == eventId;
        allow update, delete: if false;
      }
      match /settings/{id} { allow read: if member(ws); allow create, update: if owner(ws); allow delete: if false; }
      match /profitShareAllocations/{id} { allow read: if finance(ws); allow write: if owner(ws); }
      match /attendees/{id} { allow read: if member(ws); allow write: if owner(ws); }
      match /invitations/{id} { allow read: if owner(ws); allow write: if false; }
    }
    // No legacy collaboration-group or global profile field can confer workspace authority.
    match /{document=**} { allow read, write: if false; }
  }
}
