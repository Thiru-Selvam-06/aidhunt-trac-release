rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    // Firebase Auth signs this claim; a form's phone number is not OTP evidence.
    function verifiedPhone() {
      return signed() && request.auth.token.get('phone_number', '') is string &&
        request.auth.token.get('phone_number', '') != '';
    }
    function memberPath(ws, uid) { return /databases/$(database)/documents/workspaces/$(ws)/members/$(uid); }
    function active(ws, uid) {
      return uid is string && uid != '' && exists(memberPath(ws, uid)) &&
        get(memberPath(ws, uid)).data.status in ['ACTIVE', 'active'];
    }
    function member(ws) { return signed() && active(ws, request.auth.uid) && (owner(ws) || partner(ws) || operator(ws)); }
    function role(ws, roles) {
      return signed() && get(memberPath(ws, request.auth.uid)).data.status in ['ACTIVE', 'active'] &&
        get(memberPath(ws, request.auth.uid)).data.role in roles;
    }
    function owner(ws) {
      return role(ws, ['OWNER', 'Owner', 'owner']) &&
        get(/databases/$(database)/documents/workspaces/$(ws)).data.ownerUid == request.auth.uid;
    }
    function partner(ws) { return role(ws, ['PARTNER', 'Partner', 'partner']); }
    function operator(ws) { return role(ws, ['OPERATOR', 'Operator', 'operator']); }
    function finance(ws) { return owner(ws) || partner(ws); }
    // Partner companion expenses follow the selected beneficiary of their own job.
    function linkedExpenseTarget(ws, data) {
      let job = getAfter(/databases/$(database)/documents/workspaces/$(ws)/entries/$(string(data.get('relatedJobId', 0))));
      return partner(ws) && data.get('relatedJobId', 0) is int && data.relatedJobId > 0 &&
        job.data.workspaceId == ws && job.data.createdByUid == request.auth.uid &&
        job.data.entryForUid == data.expenseForUid && job.data.isHistorical == false &&
        job.data.get('isDeleted', false) == false;
    }
    function envelope(ws) {
      return request.resource.data.protocolVersion == 2 && request.resource.data.operationType in ['UPSERT', 'DELETE'] && request.resource.data.dependencies is list && request.resource.data.dependencies.size() <= 100 &&
        request.resource.data.workspaceId == ws && request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.operationId is string && request.resource.data.operationId != '' &&
        request.resource.data.actionTime is int && request.resource.data.actionTime > 0 &&
        request.resource.data.actionTime <= request.time.toMillis() && request.resource.data.isDeleted is bool &&
        (request.resource.data.isDeleted
          ? request.resource.data.get('authorizationDeletedAt', null) == request.time
          : request.resource.data.get('authorizationDeletedAt', null) == null);
    }
    // Approved offline policy: client action time is not tamper-proof. createdAt is immutable.
    function timely(createdAt) {
      return createdAt is int && createdAt > 0 && request.resource.data.actionTime >= createdAt &&
        request.resource.data.actionTime - createdAt < 86400000;
    }
    function same(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function original() { return same(['workspaceId', 'createdByUid', 'createdByRole', 'createdAt', 'authorizationCreatedAt', 'serverReceivedAt', 'authorizationTimeStatus']); }
    function reviewedTime() { return resource.data.get('authorizationTimeStatus', '') in ['CLIENT_ORIGINAL_V2', 'VERIFIED']; }
    function ownTimely() { return reviewedTime() && resource.data.createdByUid == request.auth.uid && reviewedTime() && timely(resource.data.get('createdAt', 0)); }
    // The queued command remains durable until this physical delete is acknowledged.
    function deleteEnvelope() {
      return resource.data.get('protocolVersion', 0) == 2 && resource.data.get('operationType', '') in ['UPSERT', 'DELETE'] && resource.data.get('dependencies', null) is list && resource.data.get('isDeleted', false) == true && resource.data.actorUid == request.auth.uid &&
        resource.data.operationId is string && resource.data.operationId != '' && resource.data.actionTime is int &&
        resource.data.actionTime > 0 && resource.data.actionTime <= request.time.toMillis();
    }
    function deleteTimely() {
      let created = resource.data.get('createdAt', 0);
      let action = resource.data.actionTime;
      return reviewedTime() && resource.data.createdByUid == request.auth.uid && created is int && created > 0 &&
        action >= created && action - created < 86400000;
    }
    function notDeleted() { return resource.data.get('isDeleted', false) == false; }
    function activeRecord(ws, targetField) {
      return active(ws, resource.data.createdByUid) && active(ws, resource.data[targetField]);
    }
    function purge(ws, uid) {
      return uid is string && uid != '' && owner(ws) &&
        exists(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)) &&
        get(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)).data.purgeState == 'PURGE_PENDING' &&
        get(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)).data.get('backupReady', false) == true;
    }
    function memberPurging(ws, uid) {
      return uid is string && uid != '' && exists(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)) &&
        get(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)).data.purgeState in ['PURGE_PENDING', 'PURGED'];
    }
    function validEntryAmounts(data) {
      return data.totalAmount is number && data.totalAmount >= 0 && data.amountReceived is number &&
        data.amountReceived >= 0 && data.pendingAmount is number && data.pendingAmount >= 0 &&
        data.totalAmount == data.amountReceived + data.pendingAmount;
    }
    function reference(ws, collection, id) {
      // Reuse one lookup: a job can validate both Customer and Tractor plus a different beneficiary.
      let target = get(/databases/$(database)/documents/workspaces/$(ws)/$(collection)/$(string(id))).data;
      return id is int && id > 0 && target is map &&
        target.get('isDeleted', false) == false && target.workspaceId == ws;
    }
    function creationTime() {
      return request.resource.data.createdAt is int && request.resource.data.createdAt > 0 &&
        request.resource.data.createdAt <= request.resource.data.actionTime;
    }
    function timedCreationTime() {
      return creationTime() && request.resource.data.authorizationTimeStatus == 'CLIENT_ORIGINAL_V2' && request.resource.data.authorizationCreatedAt is timestamp &&
        request.resource.data.authorizationCreatedAt.toMillis() == request.resource.data.createdAt &&
        request.resource.data.serverReceivedAt == request.time;
    }
    // Selected business collector is separate from the authenticated recorder (collectedByUid).
    // Legacy queued self-collections without collector* retain their existing authorization.
    function validCollectionCollector(ws, data) {
      let uid = data.get('collectorUid', data.collectedByUid);
      let target = get(memberPath(ws, uid)).data;
      // The membership path is authoritative; older valid members have no redundant workspaceId.
      return uid is string && active(ws, uid) && target.get('workspaceId', ws) == ws && target.role in ['OWNER', 'Owner', 'owner', 'PARTNER', 'Partner', 'partner'] &&
        (owner(ws) || uid == request.auth.uid) &&
        (!data.keys().hasAny(['collectorUid', 'collectorName', 'collectorRole']) ||
          (data.collectorUid == uid && data.collectorName == (target.get('displayName', null) == null ? '' : target.displayName) && data.collectorRole == target.role));
    }
    function validCollectionDate(ws, data) {
      let source = get(/databases/$(database)/documents/workspaces/$(ws)/entries/$(string(data.jobEntryId))).data;
      // Fixed UTC+05:30 business calendar: same creation day is allowed, even at an earlier hour.
      return source.createdAt is int && source.createdAt > 0 && data.collectedAt is int && data.collectedAt > 0 &&
        timestamp.value(data.collectedAt + 19800000).date() >= timestamp.value(source.createdAt + 19800000).date();
    }
    function collectionEntryUpdate(ws, id) {
      let cid = request.resource.data.get('collectionId', '');
      let path = /databases/$(database)/documents/workspaces/$(ws)/collections/$(cid);
      let next = getAfter(path).data;
      let created = !exists(path);
      let reversal = !created && get(path).data.status == 'ACTIVE' && next.status == 'REVERSED';
      let delta = reversal ? -next.amount : next.amount;
      return finance(ws) && cid != '' && (created || reversal) && next.jobEntryId == resource.data.id &&
        next.operationId == request.resource.data.operationId && next.actorUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['protocolVersion', 'operationType', 'dependencies', 'amountReceived', 'pendingAmount', 'collectionId', 'operationId', 'actorUid', 'actionTime', 'isDeleted', 'updatedAt']) &&
        request.resource.data.amountReceived == resource.data.amountReceived + delta &&
        request.resource.data.pendingAmount == resource.data.pendingAmount - delta && validEntryAmounts(request.resource.data);
    }
    function collectionMatchesEntry(ws, id, reversal) {
      let jobId = request.resource.data.jobEntryId;
      let path = /databases/$(database)/documents/workspaces/$(ws)/entries/$(string(jobId));
      let before = get(path).data;
      let after = getAfter(path).data;
      let delta = reversal ? -request.resource.data.amount : request.resource.data.amount;
      return unlockedEntry(ws, before) && before.workspaceId == ws && before.customerId == request.resource.data.customerId &&
        before.get('isDeleted', false) == false && !memberPurging(ws, before.createdByUid) && !memberPurging(ws, before.entryForUid) &&
        after.collectionId == id && after.operationId == request.resource.data.operationId &&
        after.amountReceived == before.amountReceived + delta && after.pendingAmount == before.pendingAmount - delta &&
        validEntryAmounts(after);
    }
    // Spark-compatible deletion: per-Entry/Customer guards stabilize dependency reads.
    // One version-checked commit removes the records, guards and creates the source audit.
    function entryProofPath(ws, id) { return /databases/$(database)/documents/workspaces/$(ws)/entryDeletionProofs/$(id); }
    function deletionLockPath(ws, kind, id) { return /databases/$(database)/documents/workspaces/$(ws)/ledgerDeletionLocks/$(kind + '_' + string(id)); }
    function entryLocked(ws, id) { return exists(deletionLockPath(ws, 'ENTRY', id)); }
    function customerLocked(ws, id) { return exists(deletionLockPath(ws, 'CUSTOMER', id)); }
    function unlockedEntry(ws, data) {
      return !entryLocked(ws, data.id) && !customerLocked(ws, data.customerId);
    }
    function unlockedExpenseDelete(ws, data) {
      let jobId = data.get('relatedJobId', 0);
      let path = /databases/$(database)/documents/workspaces/$(ws)/entries/$(string(jobId));
      return jobId == 0 || (!entryLocked(ws, jobId) && (!exists(path) || !customerLocked(ws, get(path).data.customerId)));
    }
    function lockMatchesProof(ws, kind, id, proof) {
      let path = deletionLockPath(ws, kind, id);
      return !exists(path) || (get(path).data.actorUid == request.auth.uid && get(path).data.operationId == proof.operationId);
    }
    function lockableJob(ws, data) {
      let source = get(/databases/$(database)/documents/workspaces/$(ws)/entries/$(data.jobId)).data;
      return source.workspaceId == ws && (owner(ws) || (partner(ws) && source.createdByUid == request.auth.uid &&
        source.get('isHistorical', false) == false && source.get('authorizationTimeStatus', '') in ['CLIENT_ORIGINAL_V2', 'VERIFIED'] &&
        data.actionTime >= source.createdAt && data.actionTime - source.createdAt < 86400000));
    }
    function validDeletionLock(ws, id) {
      let data = request.resource.data;
      return finance(ws) && data.workspaceId == ws && data.actorUid == request.auth.uid &&
        data.kind in ['ENTRY', 'CUSTOMER'] && data.recordId is string && data.recordId.matches('^[1-9][0-9]{0,18}$') &&
        id == data.kind + '_' + data.recordId && data.jobId is string &&
        data.operationId is string && data.operationId.matches('^[A-Za-z0-9-]{1,128}$') &&
        data.actionTime is int && data.actionTime > 0 && data.actionTime <= request.time.toMillis() &&
        data.keys().hasOnly(['workspaceId','recordId','kind','actorUid','operationId','actionTime','jobId','sourceCreatedAt']) &&
        (data.kind == 'ENTRY'
          ? (data.jobId == data.recordId && lockableJob(ws, data) &&
             data.sourceCreatedAt == get(/databases/$(database)/documents/workspaces/$(ws)/entries/$(data.recordId)).data.createdAt)
          : (get(/databases/$(database)/documents/workspaces/$(ws)/customers/$(data.recordId)).data.workspaceId == ws &&
             data.sourceCreatedAt == get(/databases/$(database)/documents/workspaces/$(ws)/customers/$(data.recordId)).data.get('createdAt', null) &&
             ((data.jobId == '' && owner(ws)) || (data.jobId.matches('^[1-9][0-9]{0,18}$') && lockableJob(ws, data) &&
               string(get(/databases/$(database)/documents/workspaces/$(ws)/entries/$(data.jobId)).data.customerId) == data.recordId &&
               getAfter(deletionLockPath(ws, 'ENTRY', data.jobId)).data.operationId == data.operationId))));
    }
    function deletionCustomerUpdate(ws, id) {
      let lock = get(deletionLockPath(ws, 'CUSTOMER', id)).data;
      return lock.actorUid == request.auth.uid && lock.operationId == request.resource.data.operationId && lock.jobId != '' &&
        !existsAfter(/databases/$(database)/documents/workspaces/$(ws)/entries/$(lock.jobId)) &&
        getAfter(entryProofPath(ws, lock.jobId)).data.operationId == lock.operationId;
    }
    function validOwnedDeletionReceipt(ws, source, receipt) {
      return receipt.workspaceId == ws && receipt.collectedByUid == request.auth.uid && receipt.status == 'ACTIVE' &&
        receipt.jobEntryId == source.id && receipt.customerId == source.customerId && receipt.amount is number && receipt.amount > 0;
    }
    function ownedReceiptAmount(ws, source, ids, index) {
      return ids.size() <= index ? 0 : checkedReceiptAmount(ws, source,
        get(/databases/$(database)/documents/workspaces/$(ws)/collections/$(ids[index])).data);
    }
    function checkedReceiptAmount(ws, source, receipt) {
      return validOwnedDeletionReceipt(ws, source, receipt) ? receipt.amount : -1;
    }
    function partnerDeletionReceipts(ws, source, proof) {
      let ids = proof.collectionIds;
      let a = ownedReceiptAmount(ws, source, ids, 0);
      let b = ownedReceiptAmount(ws, source, ids, 1);
      let c = ownedReceiptAmount(ws, source, ids, 2);
      let d = ownedReceiptAmount(ws, source, ids, 3);
      let e = ownedReceiptAmount(ws, source, ids, 4);
      return ids.size() <= 5 && a >= 0 && b >= 0 && c >= 0 && d >= 0 && e >= 0 &&
        source.amountReceived == a + b + c + d + e;
    }
    function validDeletionProof(ws, id, source) {
      let proof = request.resource.data;
      return source.id is int && string(source.id) == id && proof.workspaceId == ws && proof.recordId == id && proof.actorUid == request.auth.uid &&
        proof.protocolVersion == 2 && proof.operationId is string && proof.operationId.matches('^[A-Za-z0-9-]{1,128}$') &&
        proof.actionTime is int && proof.actionTime > 0 && proof.actionTime <= request.time.toMillis() &&
        proof.sourceCreatedAt == source.createdAt && proof.customerId == source.customerId &&
        proof.sourceCreatorUid == source.get('createdByUid', '') && proof.sourceBeneficiaryUid == source.get('entryForUid', '') &&
        proof.totalAmount == source.totalAmount && proof.amountReceived == source.amountReceived && proof.pendingAmount == source.pendingAmount &&
        proof.get('deletedCollectionAuditJson', '[]') is string && proof.get('deletedCollectionAuditJson', '[]').size() <= 131072 &&
        proof.get('deletedExpenseAuditJson', '[]') is string && proof.get('deletedExpenseAuditJson', '[]').size() <= 131072 &&
        proof.collectionIds is list && proof.collectionIds.size() <= 450 && proof.collectionIds.toSet().size() == proof.collectionIds.size() &&
        (owner(ws) || (partner(ws) && source.get('isHistorical', false) == false &&
          source.get('authorizationTimeStatus', '') in ['CLIENT_ORIGINAL_V2', 'VERIFIED'] &&
          source.createdByUid == request.auth.uid &&
          get(memberPath(ws, source.entryForUid)).data.status in ['ACTIVE', 'active'] &&
          proof.actionTime >= source.createdAt && proof.actionTime - source.createdAt < 86400000 && partnerDeletionReceipts(ws, source, proof)));
    }
    // The proof create rule performs the full source/receipt validation once.
    // Every related delete must reference that newly created, immutable proof.
    function newDeletionProof(ws, id) {
      let path = entryProofPath(ws, id);
      let proof = getAfter(path).data;
      return !exists(path) && proof.workspaceId == ws && proof.recordId == id &&
        proof.actorUid == request.auth.uid && lockMatchesProof(ws, 'ENTRY', id, proof) &&
        lockMatchesProof(ws, 'CUSTOMER', proof.customerId, proof);
    }
    function compoundChildDelete(ws, jobId, creatorUid, createdAt) {
      let proof = getAfter(entryProofPath(ws, string(jobId))).data;
      return resource.data.workspaceId == ws && !existsAfter(/databases/$(database)/documents/workspaces/$(ws)/entries/$(string(jobId))) &&
        newDeletionProof(ws, string(jobId)) &&
        (owner(ws) || (partner(ws) && creatorUid == request.auth.uid &&
          resource.data.get('authorizationTimeStatus', '') in ['CLIENT_ORIGINAL_V2', 'VERIFIED'] && createdAt is int && createdAt > 0 &&
          proof.actionTime >= createdAt && proof.actionTime - createdAt < 86400000));
    }
    function singleSourceCollection() {
      return singleSourceCollectionData(resource.data);
    }
    function singleSourceCollectionData(data) {
      return data.allocationsJson is string && data.amount is number && data.amount > 0 &&
        data.allocationsJson.matches('^\\s*\\[\\s*\\{\\s*"jobId"\\s*:\\s*"?' + string(data.jobEntryId) +
          '"?\\s*,\\s*"amount"\\s*:\\s*[0-9]+(\\.[0-9]+)?\\s*\\}\\s*\\]\\s*$');
    }
    function retainedExpenseSource(ws, data) {
      let jobId = data.get('relatedJobId', 0);
      return jobId == 0 || (jobId is int && jobId > 0 &&
        existsAfter(/databases/$(database)/documents/workspaces/$(ws)/entries/$(string(jobId))) &&
        getAfter(/databases/$(database)/documents/workspaces/$(ws)/entries/$(string(jobId))).data.workspaceId == ws &&
        getAfter(/databases/$(database)/documents/workspaces/$(ws)/entries/$(string(jobId))).data.get('isDeleted', false) == false &&
        unlockedEntry(ws, getAfter(/databases/$(database)/documents/workspaces/$(ws)/entries/$(string(jobId))).data) &&
        !existsAfter(entryProofPath(ws, string(jobId))));
    }
    match /users/{uid} { allow read, write: if signed() && request.auth.uid == uid; }
    // Directory is a server-maintained discovery aid, never authorization or OTP proof.
    match /phoneDirectory/{phone} { allow get: if signed(); allow list, write: if false; }
    match /userWorkspaceMemberships/{uid}/workspaces/{ws} {
      allow read: if signed() && request.auth.uid == uid;
      allow create, update: if owner(ws) && exists(memberPath(ws, uid));
      allow delete: if owner(ws) || (signed() && request.auth.uid == uid);
    }
    match /workspaces/{ws} {
      allow get: if member(ws) || (signed() && resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if verifiedPhone() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.workspaceId == ws;
      allow update: if owner(ws) && same(['ownerUid', 'workspaceId', 'createdAt']);
      allow delete: if false;
      match /members/{uid} {
        allow read: if member(ws) || (signed() && request.auth.uid == uid);
        // First Owner bootstrap only. Subordinate membership is created by the trusted OTP service.
        allow create: if signed() && uid == request.auth.uid && request.resource.data.uid == uid &&
          request.resource.data.workspaceId == ws && request.resource.data.role in ['OWNER', 'Owner', 'owner'] &&
          request.resource.data.status in ['ACTIVE', 'active'] &&
          getAfter(/databases/$(database)/documents/workspaces/$(ws)).data.ownerUid == uid &&
          !exists(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid));
        allow update: if (owner(ws) && uid != request.auth.uid && same(['uid', 'workspaceId', 'role', 'joinedAt']) &&
          resource.data.status in ['ACTIVE', 'active'] && request.resource.data.status == 'REMOVED' &&
          existsAfter(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid))) ||
          ((owner(ws) || (signed() && request.auth.uid == uid && member(ws))) &&
           resource.data.status in ['ACTIVE', 'active'] &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'defaultHourlyRate', 'hourlyRate', 'updatedAt']));
        allow delete: if false;
      }
      match /entries/{id} {
        allow get: if finance(ws) || (operator(ws) && (!exists(/databases/$(database)/documents/workspaces/$(ws)/entries/$(id)) || resource.data.isHistorical == false));
        allow list: if finance(ws) || (operator(ws) && resource.data.isHistorical == false);
        allow create: if !customerLocked(ws, request.resource.data.customerId) && !exists(entryProofPath(ws, id)) && envelope(ws) && member(ws) && request.resource.data.createdByUid == request.auth.uid &&
          timedCreationTime() && reference(ws, 'customers', request.resource.data.customerId) &&
          (request.resource.data.get('tractorId', 0) == 0 || reference(ws, 'tractors', request.resource.data.tractorId)) &&
          request.resource.data.isDeleted == false && request.resource.data.isHistorical is bool &&
          active(ws, request.resource.data.entryForUid) && request.resource.data.financialAttributionUid == request.resource.data.entryForUid &&
          validEntryAmounts(request.resource.data) && request.resource.data.amountReceived == 0 &&
          (owner(ws) || (!request.resource.data.isHistorical &&
            (partner(ws) || (operator(ws) && request.resource.data.entryForUid == request.auth.uid))));
        allow update: if unlockedEntry(ws, resource.data) && !customerLocked(ws, request.resource.data.customerId) && envelope(ws) && !request.resource.data.isDeleted && notDeleted() && original() && same(['isHistorical', 'entryForUid', 'financialAttributionUid']) &&
          (request.resource.data.customerId == resource.data.customerId || reference(ws, 'customers', request.resource.data.customerId)) &&
          (request.resource.data.amountReceived != resource.data.amountReceived
            ? (request.resource.data.get('purgeUid', '') != ''
                ? (owner(ws) && purge(ws, request.resource.data.purgeUid) &&
                   request.resource.data.operationType == 'UPSERT' &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['protocolVersion', 'operationType', 'dependencies', 'isDeleted', 'amountReceived', 'pendingAmount', 'purgeUid', 'actorUid', 'operationId', 'actionTime']) && validEntryAmounts(request.resource.data))
                : collectionEntryUpdate(ws, id))
            : (activeRecord(ws, 'entryForUid') && validEntryAmounts(request.resource.data) &&
               (!request.resource.data.isDeleted || request.resource.data.amountReceived == 0) &&
               (request.resource.data.get('tractorId', 0) == resource.data.get('tractorId', 0) || reference(ws, 'tractors', request.resource.data.tractorId)) &&
               (owner(ws) || ((partner(ws) || operator(ws)) && !resource.data.isHistorical && ownTimely()))));
        allow delete: if (resource.data.workspaceId == ws && newDeletionProof(ws, id)) ||
          purge(ws, resource.data.createdByUid) || purge(ws, resource.data.entryForUid) || purge(ws, resource.data.financialAttributionUid);
      }
      match /expenses/{id} {
        allow read: if finance(ws);
        allow create: if retainedExpenseSource(ws, request.resource.data) && envelope(ws) && finance(ws) && request.resource.data.createdByUid == request.auth.uid &&
          timedCreationTime() && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.isDeleted == false &&
          active(ws, request.resource.data.expenseForUid) && request.resource.data.financialAttributionUid == request.resource.data.expenseForUid &&
          (owner(ws) || request.resource.data.expenseForUid == request.auth.uid || linkedExpenseTarget(ws, request.resource.data));
        allow update: if retainedExpenseSource(ws, request.resource.data) && envelope(ws) && original() && notDeleted() && activeRecord(ws, 'expenseForUid') &&
          request.resource.data.amount is number && request.resource.data.amount > 0 &&
          same(['expenseForUid', 'financialAttributionUid']) && (owner(ws) || (partner(ws) && ownTimely()));
        allow delete: if (unlockedExpenseDelete(ws, resource.data) && deleteEnvelope() && activeRecord(ws, 'expenseForUid') && (owner(ws) || (partner(ws) && deleteTimely()))) ||
          compoundChildDelete(ws, resource.data.get('relatedJobId', 0), resource.data.get('createdByUid', ''), resource.data.get('createdAt', 0)) ||
          purge(ws, resource.data.createdByUid) || purge(ws, resource.data.expenseForUid) || purge(ws, resource.data.financialAttributionUid);
      }
      match /withdrawals/{id} {
        allow read: if finance(ws);
        allow create: if envelope(ws) && finance(ws) && request.resource.data.createdByUid == request.auth.uid &&
          timedCreationTime() && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.isDeleted == false &&
          active(ws, request.resource.data.targetPartnerUid) &&
          (request.resource.data.targetPartnerUid == request.auth.uid || (owner(ws) &&
           get(memberPath(ws, request.resource.data.targetPartnerUid)).data.role in ['PARTNER', 'Partner', 'partner']));
        allow update: if envelope(ws) && original() && notDeleted() && activeRecord(ws, 'targetPartnerUid') && request.resource.data.isDeleted == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['protocolVersion', 'operationType', 'dependencies', 'isDeleted', 'authorizationDeletedAt', 'actorUid', 'operationId', 'actionTime', 'updatedAt']) &&
          (owner(ws) || (partner(ws) && ownTimely() && resource.data.targetPartnerUid == request.auth.uid));
        allow delete: if (deleteEnvelope() && activeRecord(ws, 'targetPartnerUid') &&
          (owner(ws) || (partner(ws) && resource.data.targetPartnerUid == request.auth.uid && deleteTimely()))) ||
          purge(ws, resource.data.createdByUid) || purge(ws, resource.data.targetPartnerUid);
      }
      match /collections/{id} {
        allow read: if finance(ws);
        allow create: if envelope(ws) && finance(ws) && request.resource.data.collectedByUid == request.auth.uid &&
          request.resource.data.status == 'ACTIVE' && request.resource.data.isDeleted == false &&
          request.resource.data.amount is number && request.resource.data.amount > 0 &&
          timedCreationTime() && validCollectionCollector(ws, request.resource.data) && validCollectionDate(ws, request.resource.data) &&
          request.resource.data.collectedAt is int && request.resource.data.createdAt is int && request.resource.data.createdAt > 0 && collectionMatchesEntry(ws, id, false);
        allow update: if envelope(ws) && finance(ws) && resource.data.status == 'ACTIVE' && request.resource.data.status == 'REVERSED' &&
          request.resource.data.reversedByUid == request.auth.uid && request.resource.data.isDeleted == false &&
          same(['workspaceId', 'collectorUid', 'collectorName', 'collectorRole', 'collectedByUid', 'collectedByName', 'collectedByRole', 'collectedAt', 'createdAt', 'authorizationCreatedAt', 'serverReceivedAt', 'authorizationTimeStatus', 'amount', 'jobEntryId', 'customerId', 'allocationsJson', 'id']) &&
          (owner(ws) || (partner(ws) && resource.data.collectedByUid == request.auth.uid && timely(resource.data.get('createdAt', 0)))) &&
          collectionMatchesEntry(ws, id, true);
        allow delete: if (singleSourceCollection() && compoundChildDelete(ws, resource.data.jobEntryId, resource.data.collectedByUid, resource.data.createdAt)) || purge(ws, resource.data.collectedByUid) ||
          purge(ws, get(/databases/$(database)/documents/workspaces/$(ws)/entries/$(string(resource.data.jobEntryId))).data.createdByUid) ||
          purge(ws, get(/databases/$(database)/documents/workspaces/$(ws)/entries/$(string(resource.data.jobEntryId))).data.entryForUid);
      }
      match /customers/{id} {
        allow read: if finance(ws);
        allow create: if !exists(/databases/$(database)/documents/workspaces/$(ws)/customerDeletionProofs/$(id)) && envelope(ws) && finance(ws) && creationTime() && request.resource.data.createdByUid == request.auth.uid && request.resource.data.isDeleted == false;
        allow update: if (!customerLocked(ws, id) || deletionCustomerUpdate(ws, id)) && envelope(ws) && original() && notDeleted() &&
          ((finance(ws) && request.resource.data.isDeleted == false) || (owner(ws) && request.resource.data.isDeleted == true));
        allow delete: if owner(ws) && resource.data.workspaceId == ws &&
          getAfter(/databases/$(database)/documents/workspaces/$(ws)/customerDeletionProofs/$(id)).data.actorUid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/workspaces/$(ws)/customerDeletionProofs/$(id)).data.sourceCreatedAt == resource.data.get('createdAt', null);
      }
      match /entryDeletionProofs/{id} {
        allow read: if finance(ws);
        allow create: if finance(ws) && !existsAfter(/databases/$(database)/documents/workspaces/$(ws)/entries/$(id)) &&
          validDeletionProof(ws, id, get(/databases/$(database)/documents/workspaces/$(ws)/entries/$(id)).data) &&
          request.resource.data.keys().hasOnly(['workspaceId','recordId','actorUid','operationId','actionTime','protocolVersion',
            'sourceCreatedAt','customerId','sourceCreatorUid','sourceBeneficiaryUid','totalAmount','amountReceived','pendingAmount',
            'deletedCollectionAuditJson','deletedExpenseAuditJson','collectionIds']);
        allow update, delete: if false;
      }
      match /ledgerDeletionLocks/{id} {
        allow read: if finance(ws);
        allow create: if validDeletionLock(ws, id);
        allow update: if resource.data.actorUid == request.auth.uid && validDeletionLock(ws, id);
        allow delete: if owner(ws) || (finance(ws) && resource.data.workspaceId == ws && resource.data.actorUid == request.auth.uid);
      }
      match /customerDeletionProofs/{id} {
        allow read: if finance(ws);
        allow create: if owner(ws) && request.resource.data.workspaceId == ws && request.resource.data.recordId == id &&
          request.resource.data.actorUid == request.auth.uid && request.resource.data.protocolVersion == 2 &&
          request.resource.data.operationId is string && request.resource.data.operationId.matches('^[A-Za-z0-9-]{1,128}$') &&
          request.resource.data.actionTime is int && request.resource.data.actionTime > 0 && request.resource.data.actionTime <= request.time.toMillis() &&
          request.resource.data.sourceCreatedAt == get(/databases/$(database)/documents/workspaces/$(ws)/customers/$(id)).data.get('createdAt', null) &&
          !existsAfter(/databases/$(database)/documents/workspaces/$(ws)/customers/$(id)) &&
          request.resource.data.keys().hasOnly(['workspaceId','recordId','actorUid','operationId','actionTime','protocolVersion','sourceCreatedAt','entryId']);
        allow update, delete: if false;
      }
      match /{asset}/{id} {
        allow read: if asset in ['tractors', 'extensions'] && member(ws);
        allow create: if asset in ['tractors', 'extensions'] && envelope(ws) && finance(ws) &&
          creationTime() && request.resource.data.createdByUid == request.auth.uid && request.resource.data.isDeleted == false;
        allow update: if asset in ['tractors', 'extensions'] && envelope(ws) && original() && notDeleted() && active(ws, resource.data.createdByUid) &&
          (owner(ws) || (partner(ws) && resource.data.createdByUid == request.auth.uid));
        allow delete: if asset in ['tractors', 'extensions'] &&
          ((deleteEnvelope() && active(ws, resource.data.createdByUid) && (owner(ws) || (partner(ws) && resource.data.createdByUid == request.auth.uid))) ||
           purge(ws, resource.data.createdByUid));
      }
      match /deletedUsers/{uid} {
        match /backupChunks/{chunk} {
          allow read: if owner(ws);
          allow create: if owner(ws) && request.resource.data.workspaceId == ws && request.resource.data.memberUid == uid && request.resource.data.data is string &&
            get(/databases/$(database)/documents/workspaces/$(ws)/deletedUsers/$(uid)).data.purgeState in ['ARCHIVED', 'PURGE_PENDING'];
          allow update, delete: if false;
        }
        allow read: if owner(ws);
        allow create: if owner(ws) && uid != request.auth.uid && request.resource.data.uid == uid && request.resource.data.workspaceId == ws &&
          request.resource.data.removedByUid == request.auth.uid && request.resource.data.purgeState == 'ARCHIVED' &&
          getAfter(memberPath(ws, uid)).data.status == 'REMOVED';
        allow update: if owner(ws) && same(['uid', 'workspaceId', 'role', 'removedAt', 'removedByUid']) &&
          ((resource.data.purgeState == 'ARCHIVED' && request.resource.data.purgeState == 'PURGE_PENDING' &&
            request.resource.data.backupSha256 is string && request.resource.data.purgeManifest is list) ||
           (resource.data.purgeState == 'PURGE_PENDING' && request.resource.data.purgeState in ['PURGE_PENDING', 'PURGED']));
        allow delete: if false;
      }
      match /settings/{id} { allow read: if member(ws); allow create, update: if owner(ws); allow delete: if false; }
      match /profitShareAllocations/{id} { allow read: if finance(ws); allow write: if owner(ws); }
      match /attendees/{id} { allow read: if member(ws); allow write: if owner(ws); }
      match /invitations/{id} { allow read: if owner(ws); allow write: if false; }
    }
    // No legacy collaboration-group or global profile field can confer workspace authority.
    match /{document=**} { allow read, write: if false; }
  }
}
