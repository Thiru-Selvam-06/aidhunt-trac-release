# =============================================================================
# AIDHUNT Trac - Environment Configuration Template (.env.example)
# =============================================================================
# For standard development using the isolated 'deviceTest' variant, no private
# credentials are required. The app connects to local emulators on loopback.
# For full environment setup details, see docs/ENVIRONMENT_SETUP.md.
# =============================================================================

# Android Client API Key override (optional; leave empty for emulator)
FIREBASE_API_KEY=""

# Backend / Emulator Environment Variables (Configured in environment or CI):
# GCLOUD_PROJECT=demo-aidhunt-v16
# FIRESTORE_EMULATOR_HOST=127.0.0.1:18180
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099
# FUNCTIONS_EMULATOR=true
# INVITATION_SMS_ENABLED=false
# INVITATION_TEST_PHONES=
