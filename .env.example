# =============================================================================
# AIDHUNT Trac - Environment Configuration Template (.env.example)
# =============================================================================
# Note: For standard development, building, and physical USB installation using
# the isolated 'deviceTest' variant, NO privileged credentials are required!
# The app automatically initializes against local emulators on loopback:
#   - Firebase Auth:      127.0.0.1:19099
#   - Cloud Firestore:    127.0.0.1:18180
#   - Cloud Functions:    127.0.0.1:15001
#   - Local Room DB:      aidhunt_device_test_v18.db
#
# Copy this file to .env before customizing. Do NOT commit .env with real secrets.
# =============================================================================

# --- 1. Client Environment (Non-Sensitive / Public) ---
# Project ID used for emulator suite tests and local verification
GCLOUD_PROJECT=demo-aidhunt-v16

# Optional API key override for physical device testing with custom Firebase project
FIREBASE_API_KEY=

# --- 2. Local Emulator Endpoints (Non-Sensitive) ---
FIRESTORE_EMULATOR_HOST=127.0.0.1:18180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099
FUNCTIONS_EMULATOR=true

# --- 3. Backend Feature Flags (Non-Sensitive) ---
# Disable external SMS gateways by default in development
INVITATION_SMS_ENABLED=false
INVITATION_TEST_PHONES=

# --- 4. Privileged Secrets (DO NOT COMMIT VALUES - GitHub Actions Secrets Only) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# RELEASE_KEYSTORE_PASSWORD=
# RELEASE_KEY_ALIAS=
# RELEASE_KEY_PASSWORD=
