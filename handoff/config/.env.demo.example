# Local synthetic backend/test environment only. Not production settings.
# Android Firebase selection uses google-services.json, not FIREBASE_API_KEY here.
GCLOUD_PROJECT=demo-aidhunt-v16
FIRESTORE_EMULATOR_HOST=127.0.0.1:18180
# Set 127.0.0.1:19099 only for Auth/device integration; keep blank for HTTP/Rules tests.
FIREBASE_AUTH_EMULATOR_HOST=
# Firebase CLI sets this for the Functions emulator process; do not fake it globally.
FUNCTIONS_EMULATOR=
FIREBASE_API_KEY=
INVITATION_SMS_ENABLED=false
INVITATION_TEST_PHONES=
